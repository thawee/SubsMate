<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Glow behind Wallet (fades out so no hard edge shows inside the mask) -->
    <path android:pathData="M 54,20 C 72.78,20 88,35.22 88,54 C 88,72.78 72.78,88 54,88 C 35.22,88 20,72.78 20,54 C 20,35.22 35.22,20 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:color="#5960A5FA" android:offset="0.0" />
                <item android:color="#0060A5FA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Artwork scaled to 75% and centered so it stays inside the adaptive-icon safe zone (66dp circle) -->
    <group
        android:pivotX="54"
        android:pivotY="59.5"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateY="-5.5">

        <!-- Rear Wallet Body (Deep Slate/Navy) -->
        <path
            android:fillColor="#0F172A"
            android:pathData="M 22,50 C 22,47 24,45 27,45 L 81,45 C 84,45 86,47 86,50 L 86,81 C 86,84 84,86 81,86 L 27,86 C 24,86 22,84 22,81 Z" />

        <!-- Inner Card Sticking Out (Gold / Amber) -->
        <path
            android:fillColor="#F59E0B"
            android:pathData="M 34,36 C 34,34 35,33 37,33 L 71,33 C 73,33 74,34 74,36 L 74,58 L 34,58 Z" />
    
        <!-- Inner Card Details (EMV Chip) -->
        <path
            android:fillColor="#FEF3C7"
            android:pathData="M 38,37 L 46,37 L 46,43 L 38,43 Z" />
        <path
            android:strokeColor="#D97706"
            android:strokeWidth="1.0"
            android:pathData="M 42,37 L 42,43 M 38,40 L 46,40" />

        <!-- Infinity-Link (recurring subscriptions), engraved on the card -->
        <path
            android:strokeColor="#1E3A8A"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M 64,40 C 60.5,36.5 56,37 56,40 C 56,43 60.5,43.5 64,40 C 67.5,36.5 72,37 72,40 C 72,43 67.5,43.5 64,40 Z" />

        <!-- Front Wallet Pocket (Electric Navy 700) -->
        <path
            android:fillColor="#1D4ED8"
            android:pathData="M 22,58 L 86,58 L 86,81 C 86,84 84,86 81,86 L 27,86 C 24,86 22,84 22,81 Z" />

        <!-- Top Rim Highlight on Front Pocket -->
        <path
            android:strokeColor="#60A5FA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:pathData="M 23,58.5 L 85,58.5" />

        <!-- Mate Series Signature "M" Monogram (Pure White) -->
        <!-- Middle V-dip lowered to Y=75 based on user feedback -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M 42,78 L 42,65 L 54,75 L 66,65 L 66,78" />
    </group>

</vector>
